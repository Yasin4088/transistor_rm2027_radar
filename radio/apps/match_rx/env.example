# Match RX uses apps/match_rx/config.yaml as the primary configuration file.
# Copy config.yaml to a robot-specific YAML file, then point MATCH_RX_CONFIG at it.

export MATCH_RX_CONFIG=apps/match_rx/config.yaml

# Optional overrides for one-off runs. Prefer editing YAML for committed defaults.
# To source a dedicated override file explicitly, set MATCH_RX_ENV_FILE.
export RM_RADIO_APP_HOST=127.0.0.1
export RM_RADIO_APP_PORT=8765
export RM_RADIO_DRY_RUN=false
# export MATCH_RX_ENV_FILE=/tmp/match-rx-debug.env

# Common match-day overrides.
# export RM_RADIO_SIDE=red
# export INTERFERENCE_LEVEL=1
# export RX1_URI=ip:192.168.9.110
# export RX2_URI=ip:192.168.9.111
# export REFEREE_PORT=/dev/serial/by-id/usb-FTDI_FT232R_USB_UART_A5069RR4-if00-port0
