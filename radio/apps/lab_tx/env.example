# Lab TX uses apps/lab_tx/config.yaml as the primary configuration file.
# Copy config.yaml to a bench-specific YAML file, then point LAB_TX_CONFIG at it.

export LAB_TX_CONFIG=apps/lab_tx/config.yaml

# Optional overrides for one-off runs. Prefer editing YAML for committed defaults.
# To source a dedicated override file explicitly, set LAB_TX_ENV_FILE.
export RM_RADIO_DASHBOARD_HOST=127.0.0.1
export RM_RADIO_DASHBOARD_PORT=8780
export RM_RADIO_LAB_TX_ANTENNA_CONFIRM=false
# export LAB_TX_ENV_FILE=/tmp/lab-tx-debug.env

# Actual RF transmit remains blocked unless this is true.
# Set only after checking antenna, attenuation, SDR URI, and local RF safety.
# export RM_RADIO_LAB_TX_ANTENNA_CONFIRM=true

# Current bench TX topology. The interference URI was identified independently
# by hardware serial; do not replace it with a bus-dependent usb:X.Y.Z URI.
export BROADCAST_TX_URI=ip:192.168.2.1
export BROADCAST_TX_ATTENUATION_DB=61
export INTERFERENCE_TX_URI=ip:192.168.3.1
export INTERFERENCE_TX_ATTEND_GR=11
