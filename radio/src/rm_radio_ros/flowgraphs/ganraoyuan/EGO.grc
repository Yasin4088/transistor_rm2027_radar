- name: note_1
  id: note
  parameters:
    alias: ''
    comment: "\u8FD9\u4E2A\u6D41\u56FE\u662F\u5E72\u6270\u6E90\u4E00\u4E8C\u4E09\u7684\
      \u53D1\u9001\n1.\u53D1\u9001\u4E4B\u524D\u786E\u8BA4\u5E26\u5BBD\u9009\u5BF9\
      \u4E86\u5C31\u884C\n\u63A5\u6536\u53C2\u6570\u8BBE\u7F6E\uFF1A\n1.\u53D1\u9001\
      \u8870\u51CF\n2.\u4FE1\u53F7\u6295\u653E\u7684\u9891\u70B9\n\u662F\u54EA\u4E2A\
      \u5E72\u6270\u5C31\u5728qt\u7A97\u53E3\u8BBE\u7F6E\u5728\u54EA\u4E2A\u9891\u70B9\
      \u5C31\u884C\u4E86\uFF0C\u53D1\u9001\u8870\u51CF\u5C31\u6839\u636E\u673A\u578B\
      \u7ED9\u4E2A\u5927\u6982\uFF0C\n\u6709pa\u5C31\u7ED9\u5927\u4E00\u70B9\uFF0C\
      \u6CA1pa\u5C31\u5C0F\u4E00\u70B9\u3002\u4F46\u8FD8\u662F\u5EFA\u8BAE\u6574\u4E2A\
      \u9891\u8C31\u5206\u6790\u4EEA\u6216\u8005\u5176\u4ED6\u7684\u529F\u7387\u6D4B\
      \u8BD5\u8BBE\u5907\uFF0C\n\u6D4B\u4E00\u4E2A\u51C6\u786E\u7684-10dBm\u5BF9\u5E94\
      \u7684\u8870\u51CF\uFF0C\u7ED9\u5927\u4E86\u5E7F\u64AD\u6E90\u5C31\u6BDB\u90FD\
      \u6CA1\u6709\u4E86"
    note: "\u5E72\u6270\u6E90\u53D1\u9001"
  states:
